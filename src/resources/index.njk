---
layout: base.njk
title: Resources & Blog - Boston Digital Marketing
description: Digital marketing guides, insights, and case studies to help your business grow online.
---

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-inner hero-solo">
    <div>
      <span class="eyebrow reveal" style="--d:.05s">Resources & Insights</span>
      <h1 class="reveal" style="--d:.12s">Marketing playbooks<br>that actually work<span class="dot">.</span></h1>
      <p class="lead reveal" style="--d:.22s">Real strategies, real numbers, real results from the campaigns we're running for Boston businesses every day.</p>
    </div>
  </div>
  <div class="watermark">RESOURCES</div>
</section>

<!-- FEATURED + LATEST -->
<section class="blog-section">
  <div class="wrap">
    {%- set sortedPosts = collections.post | reverse -%}
    {%- set featured = sortedPosts[0] -%}
    {%- if featured -%}
      <a href="{{ featured.url }}" class="blog-featured reveal">
        <div class="blog-featured-img">
          <div class="blog-img-overlay"></div>
          <span class="blog-featured-tag blog-tag-{{ featured.data.categoryColor or 'lime' }}">{{ featured.data.category }}</span>
        </div>
        <div class="blog-featured-body">
          <div class="blog-meta">
            <span>Featured</span>
            <span class="dot-sep">·</span>
            <span>{{ featured.data.displayDate }}</span>
            <span class="dot-sep">·</span>
            <span>{{ featured.data.readTime }}</span>
          </div>
          <h2>{{ featured.data.title }}</h2>
          <p>{{ featured.data.excerpt }}</p>
          <div class="blog-author">
            <div class="blog-author-avatar">{{ featured.data.author | replace(" ", "") | truncate(2, true, "") | upper }}</div>
            <div>
              <div class="blog-author-name">{{ featured.data.author }}</div>
              <span class="blog-read">Read article <span class="arr">→</span></span>
            </div>
          </div>
        </div>
      </a>
    {%- endif -%}

    <div class="blog-section-head">
      <h2>Latest Articles</h2>
      <span class="blog-section-sub">Fresh insights every week</span>
    </div>

    <div class="blog-grid">
      {% for post in sortedPosts %}
        {% if loop.index > 1 %}
          <a href="{{ post.url }}" class="blog-card reveal">
            <div class="blog-card-img">
              <span class="blog-tag blog-tag-{{ post.data.categoryColor or 'lime' }}">{{ post.data.category }}</span>
            </div>
            <div class="blog-card-body">
              <div class="blog-meta">
                <span>{{ post.data.displayDate }}</span>
                <span class="dot-sep">·</span>
                <span>{{ post.data.readTime }}</span>
              </div>
              <h3>{{ post.data.title }}</h3>
              <p>{{ post.data.excerpt }}</p>
              <span class="blog-read">Read more <span class="arr">→</span></span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- NEWSLETTER -->
<section class="blog-newsletter">
  <div class="wrap blog-newsletter-inner">
    <div>
      <span class="eyebrow coral">Get the Playbooks</span>
      <h2>One weekly email. Zero fluff.</h2>
      <p>Join 2,400+ Boston business owners getting the marketing strategies that actually move the needle.</p>
    </div>
    <form action="{{ site.formEndpoint }}" method="POST" class="newsletter-form">
      <input type="hidden" name="_subject" value="New newsletter subscriber">
      <input type="hidden" name="_next" value="{{ site.siteUrl }}/thank-you/">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="form_source" value="newsletter">
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
      <input type="email" name="email" required placeholder="you@yourbusiness.com" autocomplete="email" />
      <button type="submit" class="btn btn-lime">Subscribe <span class="arr">→</span></button>
    </form>
  </div>
</section>

<!-- CTA -->
<section class="ctaband">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <div>
        <h2>Need help now?</h2>
        <p>Book a strategy call with our team to discuss your marketing challenges.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
  </div>
</section>
