---
layout: base.njk
pagination:
  data: industries
  size: 1
  alias: industry
permalink: /industries/{{ industry.slug }}/
eleventyComputed:
  title: "{{ industry.title }} — Marketing for {{ industry.shortTitle }} in Boston"
  description: "{{ industry.hero.lead }} Built specifically for {{ industry.shortTitle | lower }}. Book a free strategy call."
---

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-inner hero-form-layout">
    <div>
      <span class="eyebrow reveal" style="--d:.05s">{{ industry.hero.eyebrow }}</span>
      <h1 class="reveal" style="--d:.12s">{{ industry.hero.headline }}</h1>
      <p class="lead reveal" style="--d:.22s">{{ industry.hero.lead }}</p>
      <div class="hero-cta reveal" style="--d:.3s">
        <a href="/case-studies/" class="link-underline">View Our Results →</a>
      </div>
    </div>
    <aside class="reveal" style="--d:.2s">
      <div class="hero-form-card">
        <span class="hero-form-eyebrow">Free Strategy Call</span>
        <h3>Get more {{ industry.shortTitle | lower }} clients.</h3>
        <p class="hero-form-sub">Tell us about your practice. We'll respond within 24 hours with a custom {{ industry.title | lower }} plan — no obligation.</p>
        <form action="{{ site.formEndpoint }}" method="POST" class="hero-form">
          <input type="hidden" name="_subject" value="Strategy call request — {{ industry.title }}">
          <input type="hidden" name="_next" value="{{ site.siteUrl }}/thank-you/">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">
          <input type="hidden" name="form_source" value="industry:{{ industry.slug }}">
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
          <input type="text" name="name" required placeholder="Your name" autocomplete="name" />
          <input type="email" name="email" required placeholder="Email address" autocomplete="email" />
          <input type="tel" name="phone" placeholder="Phone (optional)" autocomplete="tel" />
          <textarea name="message" rows="3" placeholder="What are you looking to achieve?"></textarea>
          <button type="submit" class="btn btn-lime hero-form-btn">Get My Free Plan <span class="arr">→</span></button>
          <div class="hero-form-trust">
            <span><span class="check">✓</span> No obligation</span>
            <span><span class="check">✓</span> 24hr response</span>
            <span><span class="check">✓</span> 100% private</span>
          </div>
          <div class="hero-form-call">Prefer to talk? Call <a href="tel:{{ site.phone }}">{{ site.phone }}</a></div>
        </form>
      </div>
    </aside>
  </div>
  <div class="watermark">{{ industry.title | upper }}</div>
</section>

<!-- PROOF BAR -->
<section class="proof-bar">
  <div class="wrap proof-bar-inner">
    <div class="proof-stat">
      <span class="proof-num">200+</span>
      <span class="proof-lbl">Boston Clients Served</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">3.6x</span>
      <span class="proof-lbl">Avg Return on Ad Spend</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">4.9★</span>
      <span class="proof-lbl">Client Satisfaction</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">24hr</span>
      <span class="proof-lbl">Response Time</span>
    </div>
  </div>
</section>

<!-- OPTIONAL INDUSTRY IMAGE (drop /images/industries/{slug}.jpg to enable) -->
<section class="industry-image-band" data-image-slot>
  <img src="/images/industries/{{ industry.slug }}.jpg" alt="{{ industry.title }} marketing"
       loading="lazy" decoding="async" width="1600" height="800"
       onerror="this.closest('[data-image-slot]').remove()">
</section>

<!-- WHY CHOOSE US -->
<section style="background:var(--parchment);color:var(--black);padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">We know your industry. We solve your challenges.</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px">
      {% for challenge in industry.challenges %}
        <div style="text-align:center">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--coral);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:28px;color:#fff">✕</div>
          <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;color:#111">{{ challenge.title }}</h3>
          <p style="color:#55524c;line-height:1.6">{{ challenge.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- SOLUTIONS -->
{% if industry.solutions %}
<section style="background:#111;color:#fff;padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">Built for {{ industry.shortTitle | lower }}<span class="dot">.</span></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:30px;max-width:1100px;margin:0 auto">
      {% for solution in industry.solutions %}
        <div style="padding:24px;background:var(--black-3);border-radius:4px;border-left:4px solid var(--lime)">
          <h3 style="font-size:15px;font-weight:800;color:var(--lime);margin:0 0 10px;text-transform:uppercase;letter-spacing:.06em">{{ solution.split(':')[0] }}</h3>
          {% if solution.split(':')[1] %}<p style="color:#b9b4ab;margin:0;font-size:14px;line-height:1.5">{{ solution.split(':')[1] }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CASE STUDY SPOTLIGHT -->
{% if industry.caseStudy %}
<section style="background:var(--parchment);color:var(--black);padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">Real results for {{ industry.shortTitle | lower }}<span class="dot">.</span></h2>

    <div style="background:#fff;padding:54px;max-width:800px;margin:0 auto;border:1px solid rgba(0,0,0,.08)">
      <h3 style="font-size:18px;font-weight:900;margin:0 0 8px">{{ industry.caseStudy.client }}</h3>
      <p style="color:#999;font-size:13px;margin:0 0 32px">{{ industry.caseStudy.client }} • {{ industry.title }}</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:30px;margin:0 0 32px">
        {% for result in industry.caseStudy.results %}
          <div>
            <div style="font-size:32px;font-weight:900;color:var(--coral);line-height:1">{{ result.metric }}</div>
            <div style="font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#999;margin-top:8px">{{ result.label }}</div>
          </div>
        {% endfor %}
      </div>

      <blockquote style="border-left:4px solid var(--coral);padding-left:20px;margin:0;font-size:16px;line-height:1.6;color:#333;font-style:italic">
        "{{ industry.caseStudy.quote }}"
      </blockquote>
    </div>
  </div>
</section>
{% endif %}

<!-- FAQ SECTION -->
{% set industryFaqs = [
  { "q": "How long until I see new customers from marketing?", "a": "Most " + industry.shortTitle | lower + " see initial results in 30-60 days, with significant compounding growth at the 6-month mark. Paid channels deliver fastest; SEO and content compound over time." },
  { "q": "How much should a " + industry.shortTitle | lower + " business budget for marketing?", "a": "Most of our " + industry.shortTitle | lower + " clients invest $3,000-$8,000/month total (media + management) to start. We help you right-size based on growth goals, current revenue, and competitive landscape." },
  { "q": "Do you work with multi-location " + industry.shortTitle | lower + "?", "a": "Yes — we have proven playbooks for scaling marketing across multiple locations with location-specific campaigns, Google Business Profile management, and consolidated reporting." },
  { "q": "What makes you different from other " + industry.title | lower + " agencies?", "a": "We specialize in " + industry.title | lower + " specifically — not a general agency that occasionally takes on " + industry.shortTitle | lower + " clients. That means proven creative angles, vetted strategies, and benchmarks from running campaigns in your exact category." }
] %}
<section class="faq-section">
  <div class="wrap">
    <div class="faq-head">
      <span class="eyebrow coral">Common Questions</span>
      <h2>{{ industry.title }} FAQs<span class="dot">.</span></h2>
      <p>The questions {{ industry.shortTitle | lower }} ask us most about growing their practice.</p>
    </div>
    <div class="faq-list">
      {% for faq in industryFaqs %}
        <details class="faq-item">
          <summary>
            <span>{{ faq.q }}</span>
            <span class="faq-toggle" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <div class="faq-answer">{{ faq.a }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FAQPage JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in industryFaqs -%}
    {
      "@type": "Question",
      "name": {{ faq.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.a | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ]
}
</script>

<!-- RELATED INDUSTRIES + SERVICES -->
<section class="related-section">
  <div class="wrap">
    <div class="related-head">
      <span class="eyebrow coral">Services for {{ industry.shortTitle }}</span>
      <h2>The services we typically use for {{ industry.shortTitle | lower }}<span class="dot">.</span></h2>
    </div>
    <div class="related-grid">
      {%- set keyServices = ["seo", "google-ads", "meta-ads", "local-service-ads"] -%}
      {% for s in services %}
        {% if s.slug in keyServices %}
          <a href="/services/{{ s.slug }}/" class="related-card">
            <span class="related-tag">Service</span>
            <h3>{{ s.title }}</h3>
            <p>{{ s.shortDesc }}</p>
            <span class="related-arrow">Learn more →</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ctaband">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <div>
        <h2>Ready to grow your practice?</h2>
        <p>Let's build a {{ industry.title | lower }} strategy tailored to your goals.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
  </div>
</section>
