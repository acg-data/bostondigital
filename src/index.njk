---
layout: base.njk
title: Digital Marketing Agency in Boston
description: Data-driven marketing strategies that drive real growth for Boston businesses.
---

<!-- HERO -->
<section class="hero hero-bg-image">
  <div class="wrap hero-inner hero-image-layout">
    <div class="hero-content">
      <span class="eyebrow reveal" style="--d:.05s">{{ site.name }}</span>
      <h1 class="reveal" style="--d:.12s">{{ site.tagline }}<span class="dot">.</span></h1>
      <p class="lead reveal" style="--d:.22s">Data-driven strategies. Real relationships. Marketing that delivers measurable growth — for Boston businesses.</p>
      <div class="hero-cta reveal" style="--d:.3s">
        <a href="/contact/" class="btn btn-lime">{{ site.ctaLabel }} <span class="arr">→</span></a>
        <a href="/case-studies/" class="link-underline">View Our Results →</a>
      </div>
    </div>
  </div>
</section>

<!-- CLIENT LOGOS -->
<section class="logo-strip">
  <div class="wrap">
    <div class="logo-strip-head">
      <span class="eyebrow coral center">Trusted By 200+ Boston Businesses</span>
    </div>
    <div class="logo-strip-grid">
      {% for client in clients %}
        <div class="logo-strip-item">
          <img src="/images/clients/{{ client.file }}" alt="{{ client.name }}" loading="lazy">
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="services" id="services">
  <div class="wrap">
    <span class="eyebrow coral center reveal">Full-Service Digital Marketing</span>
    <h2 class="reveal">Strategy. Execution. Results<span class="dot">.</span></h2>
    <div class="svc-grid">
      {% for service in services %}
        <div class="svc reveal">
          <div class="svc-ico">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6">
              {% if service.slug == 'seo' %}
                <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>
              {% elif service.slug == 'google-ads' %}
                <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="#FF4F3E"/>
              {% elif service.slug == 'social-media' %}
                <path d="M3 10v4h4l6 5V5L7 10H3z"/><path d="M16 9a4 4 0 010 6" stroke="#FF4F3E"/>
              {% elif service.slug == 'content-marketing' %}
                <path d="M6 3h9l4 4v14H6z"/><path d="M9 9h7M9 13h7M9 17h4" stroke="#FF4F3E"/>
              {% elif service.slug == 'cro' %}
                <path d="M3 20h18"/><path d="M5 20V12M10 20V8M15 20V13M20 20V5" stroke="#C7A800"/><path d="M4 13l5-5 4 3 7-7" stroke="#FF4F3E"/>
              {% else %}
                <rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 8h18" /><path d="M9 13l-2 2 2 2M15 13l2 2-2 2" stroke="#FF4F3E"/>
              {% endif %}
            </svg>
          </div>
          <h3>{{ service.title }}</h3>
          <p>{{ service.shortDesc }}</p>
          <div class="arr-down">→</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- STATS -->
<section class="stats">
  <div class="wrap stats-inner">
    <div>
      <span class="eyebrow reveal">Results That Matter</span>
      <h2 class="reveal">We don't chase<br>vanity metrics<span class="dot">.</span><br><span class="grow">We drive growth.</span></h2>
      <p class="desc reveal">Our strategies are built around one goal: helping your business grow profitably.</p>
      <a href="/case-studies/" class="link-underline reveal">View Case Studies →</a>
    </div>
    <div class="stat-grid">
      {% for stat in stats.global %}
        <div class="stat-card reveal">
          <div class="stat-circle" style="background:var(--{% if stat.color == 'lime' %}lime{% else %}coral{% endif %})">
            {% if stat.color == 'lime' %}
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M3 17l5-5 4 3 8-8"/><path d="M16 7h4v4"/></svg>
            {% else %}
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2"><path d="M12 2v20M16 6.5C16 4.5 14 4 12 4S8 4.5 8 7s2 3 4 3.5 4 1 4 3.5-2 3-4 3-4-.5-4-2.5"/></svg>
            {% endif %}
          </div>
          <div class="stat-num" style="color:var(--{% if stat.color == 'lime' %}lime{% else %}coral{% endif %})">{{ stat.value }}</div>
          <div class="label">{{ stat.label }}</div>
          <div class="note">{{ stat.note }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process">
  <div class="wrap">
    <div class="process-head">
      <div>
        <span class="eyebrow coral reveal">Our Proven Process</span>
        <h2 class="reveal" style="margin-top:18px">A strategic process.<br>Built for results<span class="dot">.</span></h2>
      </div>
    </div>
    <div class="proc-grid">
      <div class="proc-line"></div>
      <div class="proc reveal">
        <div class="badge">1</div>
        <div class="proc-ico"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3"/></svg></div>
        <h3>Discover</h3>
        <p>We dive deep into your business, market, and goals to uncover the biggest opportunities.</p>
      </div>
      <div class="proc reveal">
        <div class="badge">2</div>
        <div class="proc-ico"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><path d="M4 4l6 6M14 14l6 6M20 4l-6 6M10 14l-6 6"/><circle cx="12" cy="12" r="2"/></svg></div>
        <h3>Strategize</h3>
        <p>We build a custom data-driven strategy tailored to your audience and revenue goals.</p>
      </div>
      <div class="proc reveal">
        <div class="badge">3</div>
        <div class="proc-ico"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><path d="M12 2c4 2 6 6 6 10l-3 4H9l-3-4c0-4 2-8 6-10z"/><circle cx="12" cy="9" r="2"/><path d="M9 20l1.5-2M15 20l-1.5-2"/></svg></div>
        <h3>Execute</h3>
        <p>We put the plan into action with precision, transparency, and constant optimization.</p>
      </div>
      <div class="proc reveal">
        <div class="badge">4</div>
        <div class="proc-ico"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="M7 16l3-4 3 2 4-6"/></svg></div>
        <h3>Measure</h3>
        <p>We track what matters and deliver clear reporting on performance and ROI.</p>
      </div>
      <div class="proc reveal">
        <div class="badge">5</div>
        <div class="proc-ico"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6"><path d="M3 20h18"/><path d="M6 20v-5M11 20V9M16 20v-8M21 20V5"/><path d="M5 11l5-5 3 3 6-6"/></svg></div>
        <h3>Grow</h3>
        <p>We scale what works and continuously improve to drive long-term growth.</p>
      </div>
    </div>
  </div>
</section>

<!-- CASE STUDIES -->
<section class="cases" id="cases">
  <div class="wrap cases-inner">
    <div>
      <span class="eyebrow reveal">Real Results. Real Businesses.</span>
      <h2 class="reveal">Success stories<br>from Boston<br>businesses<span class="dot">.</span></h2>
      <a href="/case-studies/" class="link-underline reveal">View All Case Studies →</a>
    </div>
    <div class="case-grid">
      {% for cs in case_studies %}
        {% if loop.index <= 3 %}
        <div class="case reveal">
          <div class="case-img" style="background:linear-gradient(135deg,#2a2a2a,#161616)">
            <div class="corner"></div>
            <div class="ph-ico"><svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.4"><path d="M6.5 9v6M17.5 9v6M4 10v4M20 10v4M6.5 12h11"/></svg></div>
          </div>
          <div class="case-body">
            <div class="case-tag">{{ cs.industry }}</div>
            <h3>{{ cs.results[0].metric }} {{ cs.results[0].label | lower }}</h3>
            <p>{{ cs.challenge }}</p>
            <a href="/case-studies/{{ cs.slug }}/" class="view">View Case Study →</a>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testi">
  <div class="wrap testi-inner">
    <div>
      <span class="eyebrow coral reveal">Clients Love Working With Us</span>
      <h2 class="reveal" style="margin-top:18px">Real relationships.<br>Real results<span class="dot">.</span></h2>
    </div>
    {% for testi in testimonials %}
      {% if loop.index <= 2 %}
      <div class="quote reveal">
        <div class="mark">"</div>
        <p>{{ testi.quote }}</p>
        <div class="who">
          <div class="avatar">{{ testi.initials }}</div>
          <div>
            <div class="name">— {{ testi.author }}</div>
            <div class="role">{{ testi.role }}, {{ testi.company }}</div>
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- CTA BAND -->
<section class="ctaband" id="contact">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <svg class="mini-bridge" width="58" height="80" viewBox="0 0 58 80" fill="none">
        <polygon points="27,4 31,4 33,52 25,52" fill="#FF4F3E"/>
        <polygon points="25,52 33,52 44,76 37,76" fill="#FF4F3E"/>
        <polygon points="33,52 25,52 14,76 21,76" fill="#FF4F3E"/>
        <g stroke="#FF4F3E" stroke-width=".8" opacity=".7"><line x1="29" y1="14" x2="8" y2="74"/><line x1="29" y1="14" x2="50" y2="74"/><line x1="29" y1="28" x2="18" y2="74"/><line x1="29" y1="28" x2="40" y2="74"/></g>
      </svg>
      <div>
        <h2>Ready to grow your business?</h2>
        <p>Let's build a strategy that drives real results.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">{{ site.ctaLabel }} <span class="arr">→</span></a>
  </div>
</section>
