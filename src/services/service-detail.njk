---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: /services/{{ service.slug }}/
title: "{{ service.title }} in Boston"
description: "{{ service.shortDesc }}"
---

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-inner hero-form-layout">
    <div>
      <span class="eyebrow reveal" style="--d:.05s">{{ service.hero.eyebrow }}</span>
      <h1 class="reveal" style="--d:.12s">{{ service.hero.headline }}</h1>
      <p class="lead reveal" style="--d:.22s">{{ service.hero.lead }}</p>
      <div class="hero-cta reveal" style="--d:.3s">
        <a href="/case-studies/" class="link-underline">View Our Results →</a>
      </div>
    </div>
    <aside class="reveal" style="--d:.2s">
      <div class="hero-form-card">
        <span class="hero-form-eyebrow">Free {{ service.title }} Audit</span>
        <h3>Get a custom plan to grow your business.</h3>
        <p class="hero-form-sub">Tell us about your goals and we'll respond within 24 hours with a tailored {{ service.title | lower }} plan — no obligation.</p>
        <form action="https://formspree.io/f/{{ site.formspreeId }}" method="POST" class="hero-form">
          <input type="hidden" name="_subject" value="Strategy call request — {{ service.title }}">
          <input type="hidden" name="_next" value="{{ site.siteUrl }}/thank-you/">
          <input type="hidden" name="form_source" value="service:{{ service.slug }}">
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
          <input type="text" name="name" required placeholder="Your name" autocomplete="name" />
          <input type="email" name="email" required placeholder="Email address" autocomplete="email" />
          <input type="tel" name="phone" placeholder="Phone (optional)" autocomplete="tel" />
          <textarea name="message" rows="3" placeholder="What are you looking to achieve?"></textarea>
          <button type="submit" class="btn btn-lime hero-form-btn">Get My Free Audit <span class="arr">→</span></button>
          <div class="hero-form-trust">
            <span><span class="check">✓</span> No obligation</span>
            <span><span class="check">✓</span> 24hr response</span>
            <span><span class="check">✓</span> 100% private</span>
          </div>
          <div class="hero-form-call">Prefer to talk? Call <a href="tel:{{ site.phone }}">{{ site.phone }}</a></div>
        </form>
      </div>
    </aside>
  </div>
  <div class="watermark">{{ service.title | upper }}</div>
</section>

<!-- PROOF BAR -->
<section class="proof-bar">
  <div class="wrap proof-bar-inner">
    <div class="proof-stat">
      <span class="proof-num">200+</span>
      <span class="proof-lbl">Boston Clients Served</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">3.6x</span>
      <span class="proof-lbl">Avg Return on Ad Spend</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">4.9★</span>
      <span class="proof-lbl">Client Satisfaction</span>
    </div>
    <div class="proof-stat">
      <span class="proof-num">24hr</span>
      <span class="proof-lbl">Response Time</span>
    </div>
  </div>
</section>

<!-- PROBLEMS SECTION -->
{% if service.problems %}
<section style="background:var(--parchment);color:var(--black);padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">Most campaigns have the same problems.</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px">
      {% for problem in service.problems %}
        <div style="text-align:center">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--coral);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;color:#fff">
            {% if problem.icon == 'trending-down' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7l9 9 4-4 5 5"/><path d="M21 17v-4h-4"/></svg>
            {% elif problem.icon == 'trending-up' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 17l9-9 4 4 5-5"/><path d="M21 7v4h-4"/></svg>
            {% elif problem.icon == 'users' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            {% elif problem.icon == 'clock' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {% elif problem.icon == 'activity' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            {% elif problem.icon == 'search' %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
            {% else %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            {% endif %}
          </div>
          <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;color:#111">{{ problem.title }}</h3>
          <p style="color:#55524c;line-height:1.6">{{ problem.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- BENEFITS SECTION -->
{% if service.benefits %}
<section style="background:#111;color:#fff;padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">What you get.</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:40px">
      {% for benefit in service.benefits %}
        <div style="text-align:center">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--lime);color:#111;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:28px;font-weight:900">✓</div>
          <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;color:#fff">{{ benefit.title }}</h3>
          <p style="color:#b9b4ab;line-height:1.6">{{ benefit.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- PROCESS SECTION -->
{% if service.process %}
<section style="background:var(--parchment);color:var(--black);padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 54px;text-align:center">Our process.</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:30px;max-width:1000px;margin:0 auto">
      {% for step in service.process %}
        <div style="text-align:center;position:relative">
          <div style="width:50px;height:50px;border-radius:50%;background:var(--lime);color:#111;font-weight:900;font-size:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">{{ loop.index }}</div>
          <h3 style="font-size:14px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin:0 0 12px">{{ step.title or step }}</h3>
          {% if step.desc %}<p style="color:#55524c;font-size:13px;line-height:1.5">{{ step.desc }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CTA -->
<section class="ctaband">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <div>
        <h2>Ready to get started?</h2>
        <p>Let's build a custom {{ service.title | lower }} strategy for your business.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
  </div>
</section>
