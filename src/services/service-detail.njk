---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: /services/{{ service.slug }}/
eleventyComputed:
  title: "{{ service.title }} in Boston — Strategy + Execution"
  description: "{{ service.shortDesc }} Boston-built {{ service.title | lower }} strategy that drives measurable growth. Free strategy call — no obligation."
---

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-inner hero-form-layout">
    <div>
      <span class="eyebrow reveal" style="--d:.05s">{{ service.hero.eyebrow }}</span>
      <h1 class="reveal" style="--d:.12s">{{ service.hero.headline }}</h1>
      <p class="lead reveal" style="--d:.22s">{{ service.hero.lead }}</p>
      <div class="hero-cta reveal" style="--d:.3s">
        <a href="/case-studies/" class="link-underline">View Our Results →</a>
      </div>
    </div>
    <aside class="reveal" style="--d:.2s">
      <div class="hero-form-card">
        <span class="hero-form-eyebrow">Free {{ service.title }} Audit</span>
        <h3>Get a custom plan to grow your business.</h3>
        <p class="hero-form-sub">Tell us about your goals and we'll respond within 24 hours with a tailored {{ service.title | lower }} plan — no obligation.</p>
        <form action="{{ site.formEndpoint }}" method="POST" class="hero-form">
          <input type="hidden" name="_subject" value="Strategy call request — {{ service.title }}">
          <input type="hidden" name="_next" value="{{ site.siteUrl }}/thank-you/">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">
          <input type="hidden" name="form_source" value="service:{{ service.slug }}">
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
          <input type="text" name="name" required placeholder="Your name" autocomplete="name" />
          <input type="email" name="email" required placeholder="Email address" autocomplete="email" />
          <input type="tel" name="phone" placeholder="Phone (optional)" autocomplete="tel" />
          <textarea name="message" rows="3" placeholder="What are you looking to achieve?"></textarea>
          <button type="submit" class="btn btn-lime hero-form-btn">Get My Free Audit <span class="arr">→</span></button>
          <div class="hero-form-trust">
            <span><span class="check">✓</span> No obligation</span>
            <span><span class="check">✓</span> 24hr response</span>
            <span><span class="check">✓</span> 100% private</span>
          </div>
          <div class="hero-form-call">Prefer to talk? Call <a href="tel:{{ site.phone }}">{{ site.phone }}</a></div>
        </form>
      </div>
    </aside>
  </div>
  <div class="watermark">{{ service.title | upper }}</div>
</section>

{# Shared body: proof bar, image, problems, benefits, process #}
{% include "svc-proof-bar.njk" %}
{% include "svc-content-sections.njk" %}

{# FAQs — use the per-service FAQs from services.json #}
{% set faqs = service.faqs %}
{% set faqHeading = service.title + " FAQs" %}
{% set faqIntro = "The questions Boston business owners ask us most about " + service.title | lower + "." %}
{% include "svc-faqs.njk" %}

{# Service JSON-LD (Boston-wide, since this is the canonical service page) #}
{% if service.faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": {{ service.title | dump | safe }},
  "provider": {
    "@type": "LocalBusiness",
    "name": "{{ site.name }}",
    "url": "{{ site.siteUrl }}"
  },
  "areaServed": { "@type": "City", "name": "Boston" },
  "description": {{ service.shortDesc | dump | safe }},
  "url": "{{ site.siteUrl }}/services/{{ service.slug }}/"
}
</script>
{% endif %}

<!-- RELATED SERVICES -->
<section class="related-section">
  <div class="wrap">
    <div class="related-head">
      <span class="eyebrow coral">Pair Well With {{ service.title }}</span>
      <h2>Other services that complement {{ service.title | lower }}<span class="dot">.</span></h2>
    </div>
    <div class="related-grid">
      {%- set shown = 0 -%}
      {% for s in services %}
        {% if s.slug != service.slug and shown < 3 %}
          {% set shown = shown + 1 %}
          <a href="/services/{{ s.slug }}/" class="related-card">
            <span class="related-tag">Service</span>
            <h3>{{ s.title }}</h3>
            <p>{{ s.shortDesc }}</p>
            <span class="related-arrow">Learn more →</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ctaband">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <div>
        <h2>Ready to get started?</h2>
        <p>Let's build a custom {{ service.title | lower }} strategy for your business.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
  </div>
</section>
