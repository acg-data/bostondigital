---
layout: base.njk
title: About Boston Digital Marketing
description: Learn about Boston Digital Marketing's mission, team, and approach to driving growth for Boston-area businesses.
---

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-inner hero-solo">
    <div>
      <span class="eyebrow reveal" style="--d:.05s">Our Story</span>
      <h1 class="reveal" style="--d:.12s">Digital Marketing<br>Done Right<span class="dot">.</span></h1>
      <p class="lead reveal" style="--d:.22s">We're a Boston-based team obsessed with helping businesses grow. Real results, real relationships, real transparency.</p>
      <div class="hero-cta reveal" style="--d:.3s">
        <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
      </div>
    </div>
  </div>
  <div class="watermark">ABOUT US</div>
</section>

<!-- MISSION -->
<section style="background:var(--parchment);color:var(--black);padding:96px 0">
  <div class="wrap" style="max-width:600px;margin:0 auto;text-align:center">
    <h2 style="font-size:clamp(32px,4vw,52px);margin:0 0 30px">Our Mission</h2>
    <p style="font-size:16px;line-height:1.7;color:#33312d;margin:0 0 24px">
      We help Boston businesses own their market online. No vanity metrics. No excuses. Just data-driven strategies that drive real, measurable growth.
    </p>
    <p style="font-size:16px;line-height:1.7;color:#55524c;margin:0">
      We believe in transparency, accountability, and building partnerships, not transactions. Your success is our success.
    </p>
  </div>
</section>

<!-- TEAM -->
<section class="team-section">
  <div class="wrap">
    <div class="team-head">
      <span class="eyebrow coral reveal">The Team Behind the Results</span>
      <h2 class="reveal">Meet the people growing your business<span class="dot">.</span></h2>
      <p class="team-intro reveal">A senior team obsessed with results. No account managers passing you off to juniors — you work directly with the strategists running your campaigns.</p>
    </div>
    <div class="team-grid">
      {% for member in team %}
        <div class="team-card reveal">
          <div class="team-avatar team-avatar-{{ member.accent }}">
            <span>{{ member.initials }}</span>
          </div>
          <h3>{{ member.name }}</h3>
          <div class="team-role">{{ member.role }}</div>
          <p>{{ member.bio }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- VALUES -->
<section style="background:#111;color:#fff;padding:96px 0">
  <div class="wrap">
    <h2 style="font-size:clamp(32px,4vw,52px);text-align:center;margin:0 0 64px">What Drives Us</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px;max-width:1000px;margin:0 auto">
      <div style="padding:30px;background:var(--black-3);border-left:4px solid var(--lime)">
        <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;text-transform:uppercase;color:var(--lime)">Obsessed with Results</h3>
        <p style="color:#b9b4ab;margin:0;line-height:1.6">We measure success by the growth we drive, not the activity we report.</p>
      </div>
      <div style="padding:30px;background:var(--black-3);border-left:4px solid var(--coral)">
        <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;text-transform:uppercase;color:var(--coral)">Built on Trust</h3>
        <p style="color:#b9b4ab;margin:0;line-height:1.6">Transparent reporting, honest conversations, and no hidden agendas. Ever.</p>
      </div>
      <div style="padding:30px;background:var(--black-3);border-left:4px solid var(--lime)">
        <h3 style="font-size:16px;font-weight:900;margin:0 0 12px;text-transform:uppercase;color:var(--lime)">Data-Driven</h3>
        <p style="color:#b9b4ab;margin:0;line-height:1.6">Every strategy is grounded in data. We test, measure, and optimize constantly.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="ctaband">
  <div class="wrap ctaband-inner">
    <div class="txt">
      <div>
        <h2>Ready to work with us?</h2>
        <p>Let's discuss how we can help your business grow.</p>
      </div>
    </div>
    <a href="/contact/" class="btn btn-lime">Book a Strategy Call <span class="arr">→</span></a>
  </div>
</section>
