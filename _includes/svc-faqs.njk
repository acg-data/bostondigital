{# Reusable FAQ accordion + FAQPage JSON-LD.
   Expects: `faqs` (array of {q, a}), `faqHeading` (string), `faqIntro` (string, optional) #}

{% if faqs %}
<section class="faq-section">
  <div class="wrap">
    <div class="faq-head">
      <span class="eyebrow coral">Common Questions</span>
      <h2>{{ faqHeading }}<span class="dot">.</span></h2>
      {% if faqIntro %}<p>{{ faqIntro }}</p>{% endif %}
    </div>
    <div class="faq-list">
      {% for faq in faqs %}
        <details class="faq-item">
          <summary>
            <span>{{ faq.q }}</span>
            <span class="faq-toggle" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <div class="faq-answer">{{ faq.a }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in faqs -%}
    {
      "@type": "Question",
      "name": {{ faq.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.a | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ]
}
</script>
{% endif %}
