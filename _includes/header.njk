<header id="header">
  <div class="wrap nav">
    <a href="/" class="logo" aria-label="{{ site.name }}">
      <span class="word">BOS<span class="red">T</span>ON</span>
      <span class="sub">DIGITAL MARKETING</span>
    </a>
    <nav>
      <ul>
        {% for item in site.nav %}
          {% if item.label == 'Services' %}
            <li class="has-dropdown">
              <a href="{{ item.href }}" aria-haspopup="true">{{ item.label }} <svg class="chev" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg></a>
              <div class="dropdown dropdown-mega" role="menu">
                <div class="dropdown-inner dropdown-multicol">
                  {% for cat in serviceCategories %}
                    <div class="dropdown-col">
                      <div class="dropdown-head">{{ cat.label }}</div>
                      {% for s in services %}
                        {% if s.category == cat.slug %}
                          <a href="/services/{{ s.slug }}/" role="menuitem">
                            <span class="dd-title">{{ s.title }}</span>
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </li>
          {% elif item.label == 'Resources' %}
            <li class="has-dropdown">
              <a href="{{ item.href }}" aria-haspopup="true">{{ item.label }} <svg class="chev" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg></a>
              <div class="dropdown dropdown-narrow" role="menu">
                <div class="dropdown-inner">
                  <div class="dropdown-col">
                    <a href="/resources/" role="menuitem"><span class="dd-title">Blog</span><span class="dd-sub">Articles & insights</span></a>
                    <a href="/resources/" role="menuitem"><span class="dd-title">Guides & eBooks</span><span class="dd-sub">In-depth playbooks</span></a>
                    <a href="/resources/" role="menuitem"><span class="dd-title">Webinars</span><span class="dd-sub">Live trainings</span></a>
                    <a href="/resources/" role="menuitem"><span class="dd-title">FAQs</span><span class="dd-sub">Common questions</span></a>
                  </div>
                </div>
              </div>
            </li>
          {% else %}
            <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
    <a href="{{ site.ctaHref }}" class="btn btn-lime">{{ site.ctaLabel }} <span class="arr">→</span></a>
    <button class="menu-toggle" id="menuToggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  {% for item in site.nav %}
    {% if item.label == 'Services' %}
      <details class="mm-group">
        <summary>{{ item.label }}<svg viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg></summary>
        <a href="/services/" class="mm-sub mm-sub-all">All Services →</a>
        {% for cat in serviceCategories %}
          <div class="mm-cat-label">{{ cat.label }}</div>
          {% for s in services %}
            {% if s.category == cat.slug %}
              <a href="/services/{{ s.slug }}/" class="mm-sub">{{ s.title }}</a>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </details>
    {% elif item.label == 'Resources' %}
      <details class="mm-group">
        <summary>{{ item.label }}<svg viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6"/></svg></summary>
        <a href="/resources/" class="mm-sub">Blog</a>
        <a href="/resources/" class="mm-sub">Guides & eBooks</a>
        <a href="/resources/" class="mm-sub">Webinars</a>
        <a href="/resources/" class="mm-sub">FAQs</a>
      </details>
    {% else %}
      <a href="{{ item.href }}">{{ item.label }}</a>
    {% endif %}
  {% endfor %}
  <a href="{{ site.ctaHref }}" class="btn btn-lime">{{ site.ctaLabel }} →</a>
</div>
