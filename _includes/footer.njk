<footer id="about">
  <div class="wrap foot-grid">
    <div class="foot-about">
      <a href="/" class="logo">
        <span class="word" style="font-size:26px">BOS<span class="red">T</span>ON</span>
        <span class="sub" style="font-size:10px">DIGITAL MARKETING</span>
      </a>
      <p>{{ site.description }}</p>
      <div class="socials">
        {% for social in site.socials %}
          <a href="{{ social.href }}" aria-label="{{ social.name }}">
            {% if social.icon == 'linkedin' %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4 0 4.75 2.64 4.75 6.07V21h-4v-5.4c0-1.3 0-2.96-1.8-2.96s-2.07 1.4-2.07 2.86V21h-4z"/></svg>
            {% elif social.icon == 'facebook' %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h2.7l.4-3H13V9c0-.9.3-1.5 1.6-1.5H16V4.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1V11H7v3h2.6v8z"/></svg>
            {% elif social.icon == 'instagram' %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>

    <div class="foot-col">
      <h4>Services</h4>
      {% for service in site.footerServices %}
        <a href="{{ service.href }}">{{ service.label }}</a>
      {% endfor %}
    </div>

    <div class="foot-col">
      <h4>Company</h4>
      {% for link in site.footerCompany %}
        <a href="{{ link.href }}">{{ link.label }}</a>
      {% endfor %}
    </div>

    <div class="foot-col">
      <h4>Resources</h4>
      {% for resource in site.footerResources %}
        <a href="{{ resource.href }}">{{ resource.label }}</a>
      {% endfor %}
    </div>

    <div class="foot-col foot-contact">
      <h4>Let's Talk</h4>
      <div class="row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.4-1.2a2 2 0 012.1-.5c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z"/></svg>
        {{ site.phone }}
      </div>
      <div class="row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7 10-7"/></svg>
        {{ site.email }}
      </div>
      <div class="row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        {{ site.location }}
      </div>
    </div>
  </div>

  <div class="wrap foot-bottom">
    <span>© 2025 {{ site.name }}. All rights reserved.</span>
    <span>Privacy Policy · Terms of Service</span>
  </div>
</footer>
